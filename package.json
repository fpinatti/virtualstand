    "expo-updates": "~58.0.22",
    "fast-xml-parser": "^4.5.0",
    "query-string": "^7.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-blob-util": "0.21.2",
    "react-native-pdf": "6.7.7",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
