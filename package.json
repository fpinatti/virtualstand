    "@expo/vector-icons": "^15.1.1",
    "@react-three/fiber": "^9.8.2",
    "@types/three": "^0.168.0",
    "drizzle-orm": "^0.36.4",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-gl": "~58.0.4",
    "expo-linking": "~58.0.17",
