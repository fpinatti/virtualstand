{
  "name": "virtualstand",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "start:go": "expo start --go --tunnel -c",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --host localhost",
    "update:preview": "npx eas-cli update --branch preview --auto",
    "update:prod": "npx eas-cli update --branch production --auto",
    "test": "jest",
    "ui:audit": "jest tests/unit/impeccable-ui-system.test.ts",
    "typecheck": "tsc --noEmit",
    "sync:rulebooks": "node scripts/sync-rulebooks.mjs",
